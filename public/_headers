# 长期缓存构建产物（JS/CSS/字体，文件名含 hash，变更自动失效）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 图片/视频/PDF 长缓存（内容变更时通过文件名或部署更新）
/*.jpg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/*.pdf
  Cache-Control: public, max-age=86400
